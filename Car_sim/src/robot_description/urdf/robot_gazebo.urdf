<?xml version="1.0"?>
<robot name="robot">


  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.04"/>
      </geometry>
      <material name="blue">
      	<color rgba = "0.1 0.1 1.0 0.5"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.04"/>
      </geometry>
      <material name="blue">
          <color rgba="0.1 0.1 1.0 0.5" /> 
      </material>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.00019333333" ixy="0" ixz="0" iyy="0.00033333333" iyz="0" izz="0.00019333333"/>
    </inertial>
  </link>
    

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="black">
          <color rgba="0.0 0.0 0.0 0.8" /> 
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 0.5" /> 
      </material>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000417" ixy="0" ixz="0" iyy="0.0000417" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- laser joint -->
  <joint name="laser_joint" type="fixed">
      <parent link="base_link" />
      <child link="laser_link" />
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>
    
  <link name="left_wheel_link">
      <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="yellow">
          <color rgba="1.0 1.0 0.0 0.8" /> 
      </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.02" radius="0.02"/>
        </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.5" /> 
        </material>
        <surface>
          <friction>
              <ode>
                  <mu>0.0</mu>
                  <mu2>0.0</mu2>
                  <kp>1000000000.0</kp>
                  <kd>1.0</kd>
                  <fdir1>0 0 0</fdir1>
                  <slip1>0.0</slip1>
                  <slip2>0.0</slip2>
              </ode>
          </friction>
        </surface>
     </collision>
     <inertial>
       <mass value="0.02"/>
       <inertia ixx="0.00000278" ixy="0" ixz="0" iyy="0.00000278" iyz="0" izz="0.00000004"/>
     </inertial>
  </link>

  <!-- left wheel joint -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="0 0.05 -0.015" rpy="1.57079 0 0"/>
        <axis xyz="0 0 -1" />
    </joint>


  <link name="right_wheel_link">
      <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="yellow">
          <color rgba="1.0 1.0 0.0 0.8" /> 
      </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.02" radius="0.02"/>
        </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.5" /> 
        </material>
      <surface>
          <friction>
              <ode>
                  <mu>0.0</mu>
                  <mu2>0.0</mu2>
                  <kp>1000000000.0</kp>
                  <kd>1.0</kd>
                  <fdir1>0 0 0</fdir1>
                  <slip1>0.0</slip1>
                  <slip2>0.0</slip2>
              </ode>
          </friction>
      </surface>
     </collision>
     <inertial>
       <mass value="0.02"/>
       <inertia ixx="0.00000278" ixy="0" ixz="0" iyy="0.00000278" iyz="0" izz="0.00000004"/>
     </inertial>
  </link>
<!-- right wheel joint -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="0 -0.05 -0.015" rpy="1.57079 0 0"/>
        <axis xyz="0 0 -1" />
    </joint> 

  <link name="front_boll_link">
      <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
      	<sphere radius="0.02"/>
      </geometry>
      <material name="green">
          <color rgba="0.0 1.0 0.0 0.8" /> 
      </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.5" /> 
        </material>
      <surface>
        <friction>
            <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
                <kp>1000000000.0</kp>
                <kd>1.0</kd>
                <fdir1>0 0 0</fdir1>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
            </ode>
        </friction>
      </surface>
    </collision>
  </link>

<!-- front boll joint -->
    <joint name="front_boll_joint" type="fixed">
        <parent link="base_link" />
        <child link="front_boll_link" />
        <origin xyz="0.025 0 -0.015" />
    </joint>

  <link name="behind_boll_link">
      <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="blue">
          <color rgba="0.0 0.0 1.0 0.8" /> 
      </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.5" /> 
        </material>
      <surface>
        <friction>
            <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
                <kp>1000000000.0</kp>
                <kd>1.0</kd>
                <fdir1>0 0 0</fdir1>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
            </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <joint name="behind_boll_joint" type="fixed">
      <parent link="base_link" />
      <child link="behind_boll_link" />
      <origin xyz="-0.025 0.0 -0.015" />
  </joint>

  <link name="imu_link">
      <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <link
    name="num_link">
    <inertial>
      <origin
        xyz="-0.0 -0.0 -0.0"
        rpy="0 0 0" />
      <mass
        value="0.0001" />
      <inertia
        ixx="1.0E-06"
        ixy="0"
        ixz="0"
        iyy="1.0E-06"
        iyz="0"
        izz="1.0E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0.03 -0.045 0.02"
        rpy="1.57079 0 1.57079" />
      <geometry>
        <mesh
          filename="file:///home/ubuntu/Car_sim/src/robot_description/meshes/num.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>

  </link>
  <joint
    name="Num_Joint"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="num_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>175</update_rate>
    <topic>imu</topic>
    <imu>
      <angular_velocity>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>32.0844</stddev>
            <bias_mean>0.333963</bias_mean>
            <bias_stddev>0.000000</bias_stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>27.6577</stddev>
            <bias_mean>-0.132765</bias_mean>
            <bias_stddev>0.000000</bias_stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>33.8533</stddev>
            <bias_mean>-0.272867</bias_mean>
            <bias_stddev>0.000000</bias_stddev>
          </noise>
        </z>
      </angular_velocity>
      <linear_acceleration>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.036335</stddev>
            <bias_mean>0.0</bias_mean>
            <bias_stddev>0.000</bias_stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0295582</stddev>
            <bias_mean>0.0</bias_mean>
            <bias_stddev>0.000</bias_stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.035191</stddev>
            <bias_mean>0.0</bias_mean>
            <bias_stddev>0.000</bias_stddev>
          </noise>
        </z>
      </linear_acceleration>
    </imu>
  </sensor>

  <sensor name="laser_sensor" type="gpu_lidar">
    <always_on>true</always_on>
    <visualize>true</visualize>
    <update_rate>5</update_rate>
    <pose>0 0 0.03 0 0 3.1415926</pose>
    <topic>scan</topic>
    <gz_frame_id>lidar</gz_frame_id>
    <lidar>
      <scan>
        <horizontal>
          <samples>4500</samples>
          <resolution>0.080000</resolution>
          <min_angle>0.000000</min_angle>
          <max_angle>6.280000</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.10000</min>
        <max>12</max>
        <resolution>0.015000</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </lidar>
  </sensor>

  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <!-- wheels -->
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <!-- kinematics -->
    <wheel_separation>0.1</wheel_separation>
    <wheel_diameter>0.04</wheel_diameter>
    <!-- limits -->
    <max_wheel_torque>20</max_wheel_torque>
    <max_wheel_acceleration>1.0</max_wheel_acceleration>
    <!-- output -->
    <odom_topic>odom</odom_topic>
    <topic>cmd_vel</topic>
    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>
    <odom_publisher_frequency>100</odom_publisher_frequency>
    <tf_topic>/tf</tf_topic>
  </plugin>

  <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">
    <topic>joint_states</topic>
    <joint_name>left_wheel_joint</joint_name>
    <joint_name>right_wheel_joint</joint_name>
  </plugin>

 
</robot>